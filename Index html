      <div class="profile-select-bar" id="reportProfileSelector"></div>

      <div class="grid-3" style="margin-bottom: 1.5rem;">
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-id-card"></i> Identificação & Matriz</div>
          <div id="repIdentity" style="font-size: 0.9rem; line-height: 1.6;"></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-clock"></i> Latência Estrutural (Ociosidade)</div>
          <div class="kpi-value" id="repLatencia" style="color: var(--danger); text-align: center; margin: 1rem 0;">—</div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-align: center;">Baseado nos estudos de ociosidade operacional e atrito de função.</div>
        </div>
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-fire"></i> Índice de Atrito Operacional</div>
          <div class="kpi-value" id="repAtrito" style="color: var(--highlight); text-align: center; margin: 1rem 0;">—</div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-align: center;">Risco calculado de desgaste e incompatibilidade de adaptação.</div>
        </div>
      </div>

      <div class="grid-2" style="margin-bottom: 1.5rem;">
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-book-bookmark"></i> Nota Metodológica (Neutralização de Viés)</div>
          <div class="note-box" id="repNota"></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="fa-solid fa-sliders"></i> Vetores de Performance Operacional</div>
          <div id="repVetores"></div>
        </div>
      </div>

      <div class="card">
        <div class="card-title" style="color: var(--danger);"><i class="fa-solid fa-triangle-exclamation"></i> Diagnóstico de Riscos Comportamentais & Sombras na Função</div>
        <ul id="repSombras" style="list-style-position: inside; line-height: 1.8; color: var(--text-muted); font-size: 0.9rem;"></ul>
      </div>
    </section>

    <!-- VIEW 4: SIMULADOR ROI TURNOVER -->
    <section id="view-simulator" class="view-section">
      <div class="card" style="max-width: 900px; margin: 0 auto;">
        <div class="card-title"><i class="fa-solid fa-calculator"></i> Simulador Financeiro de Prevenção de Turnover & ROI (B2B)</div>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Estime o impacto financeiro da aplicação da Matriz Analítica na retenção de capital humano e redução de custos com rescisões precoces.</p>
        
        <div class="grid-2">
          <div class="form-group">
            <label>Número Total de Colaboradores na Empresa</label>
            <input type="number" class="form-control" id="simColab" value="120" oninput="calculateROI()">
          </div>
          <div class="form-group">
            <label>Salário Médio Mensal (Kz / Moeda Base)</label>
            <input type="number" class="form-control" id="simSalario" value="350000" oninput="calculateROI()">
          </div>
        </div>
        <div class="form-group">
          <label>Taxa Anual de Turnover Esperada (%)</label>
          <input type="range" min="5" max="50" value="22" class="form-control" id="simTurnover" oninput="calculateROI()">
          <div style="font-size: 0.8rem; color: var(--accent-blue); margin-top: 0.3rem;" id="turnoverVal">22% ao ano</div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 1.5rem 0;">

        <div class="grid-3">
          <div class="card" style="background: var(--bg-primary);">
            <div class="kpi-sub">CUSTO ATUAL DE TURNOVER (PREJUÍZO)</div>
            <div class="kpi-value" id="resCustoAtual" style="font-size: 1.3rem; color: var(--danger);">32.340.000 Kz</div>
            <div class="kpi-sub">Gasto anual estimado com rescisões e novas contratações.</div>
          </div>
          <div class="card" style="background: var(--bg-primary);">
            <div class="kpi-sub">ECONOMIA ANUAL COM MATRIZ</div>
            <div class="kpi-value" id="resEconomia" style="font-size: 1.3rem; color: var(--success);">13.475.000 Kz</div>
            <div class="kpi-sub">Evitando desalinhamentos de perfil e incompatibilidade.</div>
          </div>
          <div class="card" style="background: var(--bg-primary);">
            <div class="kpi-sub">ROI PROJETADO DA SOLUÇÃO</div>
            <div class="kpi-value" id="resROI" style="font-size: 1.5rem; color: var(--highlight);">836%</div>
            <div class="kpi-sub">Retorno financeiro validado por auditoria B2B.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 5: MATRIZ DE EQUIPA -->
    <section id="view-team" class="view-section">
      <div class="card">
        <div class="card-title"><i class="fa-solid fa-users"></i> Análise de Complementaridade e Sinergia de Equipa</div>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Cruzamento de perfis para prevenir choques de liderança e mitigar a ociosidade coletiva estrutural.</p>
        <div class="grid-2" id="teamMatrixContainer"></div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="app-footer">
    <div><strong>Matriz Analítica de Alocação Comportamental®</strong> — Ferramenta B2B & HR-Tech.</div>
    <div style="margin-top: 0.3rem;">Idealizado, Desenvolvido e Registado por <strong>Fausto Antonio Gaspar</strong> | UniCesumar</div>
  </footer>

